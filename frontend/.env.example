# Copiar a .env (nunca se commitea)

# true = datos de prueba (src/lib/datos/mock.ts) · false = contrato real en testnet
PUBLIC_USAR_MOCK=true

# oficial (por defecto) · ensayo = campaña de prueba con meta 10 USDC para ensayar sin tocar la oficial
PUBLIC_CAMPANIA=oficial

# Solo servidor: JWT de Pinata para subir recuerdos a IPFS
PINATA_JWT=

# Solo servidor: clave secreta (S...) de la cuenta "grifo" que manda 100 USDC de prueba a las wallets de prueba (/api/grifo).
# Se obtiene con `stellar keys show grifo`. Esa cuenta solo tiene USDC y XLM de testnet; no es el admin.
GRIFO_SECRETO=

# --- Firma de hitos en modo demo (opcional) ---
# Solo testnet. Con FIRMA_DEMO=true cualquiera que abra la web puede aprobar hitos
# con estas claves: usalo únicamente para demos.
FIRMA_DEMO=false
# Claves secretas (S...) de las cuentas firmante1/2/3 del contrato en testnet.
# Se obtienen con `stellar keys secret firmante1` (o 2 y 3). Nunca uses claves de mainnet.
FIRMANTE1_SECRETO=
FIRMANTE2_SECRETO=
FIRMANTE3_SECRETO=
