<aside class="panel-prueba" data-panel-prueba hidden>
  <p class="m-0">
    <strong>Estás viendo datos de mentira</strong> (sin contrato real). Elegí el escenario para ensayar los flujos:
  </p>
  <label class="selector">
    Escenario:
    <select data-escenario aria-describedby="panel-prueba-nota">
      <option value="activa">Campaña activa, recaudando</option>
      <option value="financiada">Meta alcanzada: se pueden aprobar hitos</option>
      <option value="fallida">Campaña fallida: hay reembolsos para probar</option>
    </select>
  </label>
  <small id="panel-prueba-nota">
    Al cambiar de escenario la página se recarga sola. Tu billetera conectada actúa como firmante 3 y como dueña de 3
    ladrillos, para que puedas probar todo.
  </small>
  <p class="estado-panel m-0" data-panel-estado role="status" hidden></p>
</aside>

<script>
  import { usandoMock } from '../../lib/datos';
  import { escenarioMock, fijarEscenarioMock, type EscenarioMock } from '../../lib/datos/mock';

  const panel = document.querySelector('[data-panel-prueba]') as HTMLElement;
  const selector = panel.querySelector('[data-escenario]') as HTMLSelectElement;
  const estado = panel.querySelector('[data-panel-estado]') as HTMLElement;

  if (usandoMock) {
    panel.hidden = false;
    selector.value = escenarioMock();
    selector.addEventListener('change', () => {
      try {
        fijarEscenarioMock(selector.value as EscenarioMock);
        estado.hidden = false;
        estado.textContent = 'Escenario cambiado, recargando…';
        location.reload();
      } catch {
        estado.hidden = false;
        estado.textContent = 'No se pudo cambiar el escenario. Probá recargar la página.';
      }
    });
  }
</script>

<style>
  .panel-prueba[hidden] {
    display: none;
  }
  .panel-prueba {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding: 0.75rem var(--espacio);
    margin: var(--espacio) 0;
    border: 1px dashed var(--color-secundario);
    border-radius: var(--radius-xl, 1rem);
    font-size: 0.9rem;
  }
  .selector {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-weight: 600;
  }
  select {
    font: inherit;
    border-radius: var(--radius-md, 0.5rem);
    padding: 0.25rem 0.5rem;
  }
  small {
    opacity: 0.75;
  }
  .estado-panel {
    color: var(--color-secundario);
  }
</style>
