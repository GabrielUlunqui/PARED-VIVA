<aside class="panel-prueba" data-panel-prueba hidden>
  <label>
    <strong>Modo prueba</strong> (datos falsos, sin contrato) · Escenario:
    <select data-escenario>
      <option value="activa">Campaña activa</option>
      <option value="financiada">Meta alcanzada (aprobar hitos)</option>
      <option value="fallida">Campaña fallida (reembolsos)</option>
    </select>
  </label>
  <small>Tu wallet conectada actúa como firmante 3 y como dueña de 3 ladrillos.</small>
</aside>

<script>
  import { usandoMock } from '../../lib/datos';
  import { escenarioMock, fijarEscenarioMock, type EscenarioMock } from '../../lib/datos/mock';

  const panel = document.querySelector('[data-panel-prueba]') as HTMLElement;
  const selector = panel.querySelector('[data-escenario]') as HTMLSelectElement;

  if (usandoMock) {
    panel.hidden = false;
    selector.value = escenarioMock();
    selector.addEventListener('change', () => {
      fijarEscenarioMock(selector.value as EscenarioMock);
      location.reload();
    });
  }
</script>

