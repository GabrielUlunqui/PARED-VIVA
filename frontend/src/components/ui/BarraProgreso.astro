---
interface Props {
  id?: string;
  valor?: number;
  alto?: 'normal' | 'grande';
}

const { id, valor = 0, alto = 'normal' } = Astro.props;
---

<div
  class:list={['barra barra-ladrillos', { 'h-6': alto === 'grande' }]}
  id={id}
  role="progressbar"
  aria-valuemin="0"
  aria-valuemax="100"
  aria-valuenow={valor}
>
  <div class="relleno" style={`width: ${valor}%`}></div>
</div>
