---
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'button'> {
  variante?: 'primario' | 'secundario';
}

const { variante = 'primario', type = 'button', class: clase, ...resto } = Astro.props;
---

<button
  type={type}
  class:list={[
    'boton cursor-pointer px-5 py-3 font-sans text-sm font-bold uppercase tracking-wider disabled:cursor-wait disabled:opacity-60',
    variante === 'primario' ? 'boton-ladrillo' : 'boton-neon',
    clase,
  ]}
  {...resto}><slot /></button
>
