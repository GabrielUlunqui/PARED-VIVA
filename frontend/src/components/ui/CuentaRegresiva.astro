---
interface Props {
  id: string;
}

const { id } = Astro.props;
const partes = [
  { clave: 'dias', texto: 'días' },
  { clave: 'horas', texto: 'horas' },
  { clave: 'minutos', texto: 'min' },
  { clave: 'segundos', texto: 'seg' },
];
---

<div id={id} class="cuenta-regresiva" role="timer" aria-live="off">
  <p class="cargando m-0 text-sm text-white/50">Calculando…</p>
  <div class="numeros grid grid-cols-4 gap-2 text-center" hidden>
    {
      partes.map((p) => (
        <div class="caja p-2 md:p-3">
          <p class="m-0 font-display text-3xl text-ambar md:text-4xl" data-parte={p.clave} />
          <p class="m-0 text-[0.65rem] uppercase tracking-widest text-white/50">{p.texto}</p>
        </div>
      ))
    }
  </div>
  <p class="finalizada m-0 font-display text-3xl text-white/70" hidden>Campaña finalizada</p>
</div>

<script>
  const dosCifras = (n: number) => String(n).padStart(2, '0');

  // Devuelve true cuando la campaña terminó (para cortar intervalos y observadores).
  function actualizar(el: HTMLElement): boolean {
    const cargando = el.querySelector<HTMLElement>('.cargando');
    const numeros = el.querySelector<HTMLElement>('.numeros');
    const finalizada = el.querySelector<HTMLElement>('.finalizada');
    if (!el.dataset.hasta || !cargando || !numeros || !finalizada) return false;
    const restante = Number(el.dataset.hasta) - Math.floor(Date.now() / 1000);
    const terminada = restante <= 0;
    cargando.hidden = true;
    numeros.hidden = terminada;
    finalizada.hidden = !terminada;
    if (terminada) return true;
    const valores: Record<string, number> = {
      dias: Math.floor(restante / 86400),
      horas: Math.floor((restante % 86400) / 3600),
      minutos: Math.floor((restante % 3600) / 60),
      segundos: restante % 60,
    };
    numeros.querySelectorAll<HTMLElement>('[data-parte]').forEach((p) => {
      p.textContent = dosCifras(valores[p.dataset.parte ?? ''] ?? 0);
    });
    return false;
  }

  document.querySelectorAll<HTMLElement>('.cuenta-regresiva').forEach((el) => {
    let intervalo: number | undefined;
    const observer = new MutationObserver(() => {
      if (actualizar(el)) frenar();
    });
    const frenar = () => {
      if (intervalo !== undefined) clearInterval(intervalo);
      observer.disconnect();
    };
    observer.observe(el, { attributes: true, attributeFilter: ['data-hasta'] });
    if (!actualizar(el)) intervalo = window.setInterval(() => {
      if (actualizar(el)) frenar();
    }, 1000);
  });
</script>
