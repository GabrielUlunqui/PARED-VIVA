---
interface Props {
  id: string;
  titulo: string;
}

const { id, titulo } = Astro.props;
---

<dialog id={id} class="modal cartel" aria-labelledby={`${id}-titulo`}>
  <header class="mb-4 flex items-center justify-between gap-4">
    <h2 id={`${id}-titulo`} class="m-0 text-4xl text-white">{titulo}</h2>
    <button type="button" class="cerrar caja cursor-pointer px-3 py-1 text-xl text-white/80 hover:text-white" aria-label="Cerrar" data-cerrar-modal>×</button>
  </header>
  <slot />
</dialog>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-cerrar-modal]').forEach((boton) => {
    boton.addEventListener('click', () => boton.closest('dialog')?.close());
  });
  document.querySelectorAll<HTMLDialogElement>('dialog.modal').forEach((modal) => {
    modal.addEventListener('click', (e) => {
      if (e.target === modal) modal.close();
    });
    // Recuerda qué tenía el foco al abrirse y se lo devuelve al cerrar si el navegador no lo hizo.
    let abridor: Element | null = null;
    new MutationObserver(() => {
      if (modal.open && !abridor) abridor = document.activeElement;
    }).observe(modal, { attributes: true, attributeFilter: ['open'] });
    modal.addEventListener('close', () => {
      const activo = document.activeElement;
      if ((!activo || activo === document.body) && abridor instanceof HTMLElement && abridor.isConnected) abridor.focus();
      abridor = null;
    });
  });
</script>

<style>
  .modal {
    color: var(--color-texto);
    max-width: min(92vw, 520px);
    width: 100%;
    max-height: 90vh;
    overflow-x: hidden;
    overflow-y: auto;
  }
  .modal::backdrop {
    background: rgb(10 8 18 / 0.75);
    backdrop-filter: blur(3px);
  }
  .modal[open] {
    animation: entrada-modal 0.25s ease-out;
  }
  @keyframes entrada-modal {
    from {
      opacity: 0;
      transform: translateY(12px) scale(0.98);
    }
  }
</style>
