---
import Base from '../../layouts/Base.astro';
import PanelCampanias from '../../components/admin/PanelCampanias.astro';
import PanelFirmantes from '../../components/admin/PanelFirmantes.astro';
import { ADMIN_WEB, ADMIN_CLAVE } from 'astro:env/server';

export const prerender = false;

// ADMIN_WEB viene del entorno del servidor; si no está activo el panel no existe (404).
const adminActivo = ADMIN_WEB;
if (!adminActivo) {
  Astro.response.status = 404;
}
// La clave es respaldo opcional: solo se muestra el formulario si está configurada (nunca se imprime).
const hayClave = !!ADMIN_CLAVE;
---

{
  !adminActivo ? (
    <Base titulo="No encontrado">
      <h1>Página no encontrada</h1>
      <p class="text-white/60">Acá no hay nada. Volvé al <a href="/">inicio</a>.</p>
    </Base>
  ) : (
    <Base titulo="Admin" descripcion="Panel de administración de testnet de Pared Viva.">
      <p class="etiqueta m-0">Administración</p>
      <h1 class="m-0 mt-1">Panel de la pared</h1>
      <p class="caja m-0 mt-4 p-3 text-sm text-ambar">Panel de administración de testnet. Las claves viven en este servidor.</p>

      <div data-vista-login class="mx-auto mt-8 max-w-md">
        <div class="cartel grid gap-4">
          <h2 class="m-0 text-3xl">Entrar</h2>

          <div data-login-sin-wallet class="grid gap-3" hidden>
            <p class="m-0 text-sm text-white/70">Para entrar al panel usás tu billetera de admin: no hace falta contraseña.</p>
            <button type="button" class="boton-ladrillo presionable cursor-pointer rounded-md px-5 py-3 text-sm font-bold uppercase tracking-wider" data-conectar-admin>
              Conectá tu billetera de admin
            </button>
            <p class="m-0 text-xs text-white/50">Se abre el selector de billetera de arriba a la derecha.</p>
          </div>

          <div data-login-con-wallet class="grid gap-3" hidden>
            <p class="m-0 text-sm text-white/70">Tu billetera está conectada. Entrás firmando un mensaje: no se mueve plata ni se comparte tu clave.</p>
            <button type="button" class="boton-ladrillo presionable cursor-pointer rounded-md px-5 py-3 text-sm font-bold uppercase tracking-wider disabled:cursor-wait disabled:opacity-60" data-entrar-wallet>
              Entrar con mi billetera (<span data-direccion-corta></span>)
            </button>
            <p class="m-0 text-xs text-white/50" data-login-progreso aria-live="polite"></p>
          </div>

          <p class="m-0 text-sm" data-login-estado aria-live="polite">Viendo si ya tenés sesión…</p>
          <p class="m-0 text-sm font-bold text-rosa" data-login-error aria-live="polite"></p>
          <button type="button" class="boton-neon presionable cursor-pointer rounded-md px-4 py-2 text-xs font-bold uppercase tracking-wider" data-cambiar-wallet hidden>
            Cambiar de billetera
          </button>

          {hayClave && (
            <details class="text-sm">
              <summary class="cursor-pointer text-white/60 hover:text-white">Entrar con clave</summary>
              <form data-form-login class="mt-3 grid gap-3">
                <div class="grid gap-1">
                  <label for="admin-clave" class="text-sm font-bold">Clave de administración</label>
                  <input id="admin-clave" type="password" required autocomplete="current-password" class="caja w-full px-3 py-2 text-sm" />
                </div>
                <div>
                  <button type="submit" class="boton-neon presionable w-full cursor-pointer rounded-md px-5 py-3 text-sm font-bold uppercase tracking-wider disabled:cursor-wait disabled:opacity-60" data-login-boton>Entrar con clave</button>
                </div>
              </form>
            </details>
          )}
        </div>
      </div>

      <div data-vista-panel hidden>
        <div class="mt-6 flex flex-wrap items-center gap-2" role="tablist" aria-label="Secciones del panel">
          <button type="button" role="tab" aria-selected="true" class="boton-ladrillo presionable cursor-pointer rounded-md px-4 py-2 text-xs font-bold uppercase tracking-wider" data-tab="campanias">Campañas</button>
          <button type="button" role="tab" aria-selected="false" class="boton-neon presionable cursor-pointer rounded-md px-4 py-2 text-xs font-bold uppercase tracking-wider" data-tab="firmantes">Firmantes</button>
          <button type="button" class="ml-auto cursor-pointer rounded-md px-3 py-2 text-xs font-bold uppercase tracking-wider text-white/50 hover:text-white" data-salir>Cerrar sesión</button>
        </div>
        <div data-seccion="campanias" class="mt-6">
          <PanelCampanias />
        </div>
        <div data-seccion="firmantes" class="mt-6" hidden>
          <PanelFirmantes />
        </div>
      </div>
    </Base>
  )
}

<script>
  import { getJSON, postJSON, toast } from '../../components/admin/util';
  import * as wallet from '../../lib/stellar/wallet';

  const login = document.querySelector<HTMLElement>('[data-vista-login]');
  const panel = document.querySelector<HTMLElement>('[data-vista-panel]');
  if (login && panel) {
    const sinWallet = document.querySelector<HTMLElement>('[data-login-sin-wallet]')!;
    const conWallet = document.querySelector<HTMLElement>('[data-login-con-wallet]')!;
    const estadoEl = document.querySelector<HTMLElement>('[data-login-estado]')!;
    const errorEl = document.querySelector<HTMLElement>('[data-login-error]')!;
    const progresoEl = document.querySelector<HTMLElement>('[data-login-progreso]');

    const mostrarPanel = () => {
      login.hidden = true;
      panel.hidden = false;
      document.dispatchEvent(new CustomEvent('admin:sesion'));
    };

    const cerrarSesion = async (aviso?: string) => {
      try {
        await postJSON('/api/admin/sesion', undefined, 'DELETE');
      } catch {}
      panel.hidden = true;
      login.hidden = false;
      estadoEl.hidden = true;
      if (aviso) toast(aviso, 'info');
      refrescarBilletera();
    };

    async function refrescarBilletera() {
      const direccion = await wallet.direccionActual().catch(() => null);
      sinWallet.hidden = !!direccion;
      conWallet.hidden = !direccion;
      if (direccion) {
        const corta = document.querySelector<HTMLElement>('[data-direccion-corta]');
        if (corta) corta.textContent = wallet.abreviar(direccion);
      }
    }

    // Si ya hay sesión viva, entra directo; si no, muestra el camino de billetera.
    getJSON('/api/admin/estado')
      .then(() => mostrarPanel())
      .catch(() => {
        estadoEl.hidden = true;
        refrescarBilletera();
      });

    const mostrarSinAcceso = () => {
      const cambiar = document.querySelector<HTMLElement>('[data-cambiar-wallet]');
      if (cambiar) cambiar.hidden = false;
    };
    document.querySelector('[data-cambiar-wallet]')?.addEventListener('click', () => {
      // Abre el panel de la billetera del header para elegir otra cuenta o billetera.
      const chip = document.getElementById('wallet-chip');
      const botonHeader = document.getElementById('conectar-wallet');
      (chip && !chip.hidden ? chip : botonHeader)?.click();
    });

    document.querySelector('[data-conectar-admin]')?.addEventListener('click', () => {
      // El botón real de conexión vive en el header (instancia única): se le hace clic ahí.
      const botonHeader = document.getElementById('conectar-wallet');
      if (botonHeader) botonHeader.click();
      else toast('Usá el botón "Conectar billetera" de arriba a la derecha.', 'info');
    });

    document.querySelector('[data-entrar-wallet]')?.addEventListener('click', async (e) => {
      const boton = e.currentTarget as HTMLButtonElement;
      errorEl.textContent = '';
      const cambiar = document.querySelector<HTMLElement>('[data-cambiar-wallet]');
      if (cambiar) cambiar.hidden = true;
      boton.disabled = true;
      const progreso = (texto: string) => {
        if (progresoEl) progresoEl.textContent = texto;
      };
      try {
        const direccion = await wallet.direccionActual();
        if (!direccion) throw new Error('Primero conectá tu billetera de admin.');
        progreso('Pidiendo el desafío al servidor…');
        const res = await fetch(`/api/admin/desafio?direccion=${encodeURIComponent(direccion)}`);
        if (res.status === 404) throw new Error('El inicio con billetera todavía no está disponible en este servidor.');
        if (res.status === 403) {
          mostrarSinAcceso();
          throw new Error('Esta billetera no tiene acceso al panel.');
        }
        const datos = (await res.json().catch(() => ({}))) as { desafio?: string; error?: string };
        if (!res.ok || !datos.desafio) throw new Error(datos.error ?? 'No se pudo pedir el desafío. Probá de nuevo.');
        const desafio = datos.desafio;
        // firmarMensaje la agrega el backend compartido en lib/stellar; se toma dinámico para compilar antes de que exista.
        const firmarMensaje = (wallet as unknown as { firmarMensaje?: (mensaje: string) => Promise<{ firma: string; direccion: string }> }).firmarMensaje;
        if (!firmarMensaje) throw new Error('Todavía no está disponible la firma con billetera. Probá de nuevo en unos minutos.');
        progreso('Firmando con tu billetera…');
        const firmado = await firmarMensaje(desafio);
        progreso('Entrando…');
        await postJSON('/api/admin/sesion', { direccion: firmado.direccion, firma: firmado.firma });
        progreso('');
        mostrarPanel();
      } catch (err) {
        progreso('');
        errorEl.textContent = (err as Error).message;
      } finally {
        boton.disabled = false;
      }
    });

    document.querySelector('[data-form-login]')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const boton = document.querySelector<HTMLButtonElement>('[data-login-boton]')!;
      const clave = (document.querySelector<HTMLInputElement>('#admin-clave')!).value;
      boton.disabled = true;
      errorEl.textContent = '';
      try {
        await postJSON('/api/admin/sesion', { clave });
        mostrarPanel();
      } catch (err) {
        errorEl.textContent = (err as Error).message;
      } finally {
        boton.disabled = false;
      }
    });

    document.querySelector('[data-salir]')?.addEventListener('click', () => cerrarSesion('Sesión cerrada.'));

    // Al cambiar de billetera: refrescar el login y, si la nueva no tiene acceso, cerrar la sesión de admin.
    window.addEventListener('pv:wallet-cambiada', async (e) => {
      refrescarBilletera();
      const direccion = (e as CustomEvent).detail?.direccion as string | null | undefined;
      if (!direccion || panel.hidden) return;
      try {
        const res = await fetch(`/api/admin/desafio?direccion=${encodeURIComponent(direccion)}`);
        if (res.status === 403) await cerrarSesion('Cambiaste a una billetera sin acceso: se cerró la sesión de administración.');
      } catch {
        // errores de red no cierran la sesión
      }
    });

    // Pestañas
    document.querySelectorAll<HTMLButtonElement>('[data-tab]').forEach((boton) => {
      boton.addEventListener('click', () => {
        document.querySelectorAll<HTMLButtonElement>('[data-tab]').forEach((b) => {
          const activo = b === boton;
          b.setAttribute('aria-selected', String(activo));
          b.classList.toggle('boton-ladrillo', activo);
          b.classList.toggle('boton-neon', !activo);
        });
        document.querySelectorAll<HTMLElement>('[data-seccion]').forEach((seccion) => {
          seccion.hidden = seccion.dataset.seccion !== boton.dataset.tab;
        });
      });
    });
  }
</script>

<style>
  [hidden] {
    display: none !important;
  }
</style>
