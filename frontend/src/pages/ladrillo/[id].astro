---
import QRCode from 'qrcode';
import Base from '../../layouts/Base.astro';
import { campaniaActiva, RED } from '../../contracts/config';
import { datos } from '../../lib/datos';
import { leerRecuerdo, urlGateway } from '../../lib/ipfs';
import { formatearUsdc, type Campania, type Ladrillo, type Recuerdo } from '../../lib/tipos';
import { acortarDireccion } from '../../lib/formato';

export const prerender = false;

const id = Number(Astro.params.id);
let campania: Campania | null = null;
let ladrillo: Ladrillo | null = null;
let recuerdo: Recuerdo | null = null;
let falloRecuerdo = false;

try {
  campania = await datos.obtenerCampania();
  const valido = Number.isInteger(id) && id >= 0 && id < campania.filas * campania.columnas;
  ladrillo = valido ? await datos.obtenerLadrillo(id) : null;
  if (!valido) campania = null;
} catch {
  campania = null;
}
if (ladrillo) {
  recuerdo = await leerRecuerdo(ladrillo.recuerdoCid).catch(() => {
    falloRecuerdo = true;
    return null;
  });
}

const columnas = campania?.columnas ?? 30;
const filas = campania?.filas ?? 20;
const fila = Math.floor(id / columnas);
const columna = id % columnas;
const url = new URL(`/ladrillo/${Astro.params.id}`, Astro.url.origin).toString();
const qr = await QRCode.toString(url, { type: 'svg', margin: 1, color: { dark: '#0a0812', light: '#f3ede4' } });
const fecha = ladrillo ? new Date(ladrillo.fecha * 1000).toLocaleDateString('es-AR', { day: 'numeric', month: 'long', year: 'numeric' }) : '';
const explorador = `${RED.explorador}/contract/${await campaniaActiva()}`;
if (!campania) Astro.response.status = 404;
Astro.response.headers.set('Cache-Control', 'public, s-maxage=30, stale-while-revalidate=120');
---

<Base titulo={`Ladrillo #${Astro.params.id}`} descripcion={ladrillo ? `El recuerdo del ladrillo #${id} en la pared del barrio` : `El ladrillo #${id} todavía está libre: adoptalo y dejá tu recuerdo`}>
  <div class="mx-auto max-w-6xl">
    {
      !campania ? (
        <div class="cartel mx-auto max-w-xl text-center">
          <p class="etiqueta m-0">Ladrillo #{Astro.params.id}</p>
          <h1 class="m-0 mt-2">Este ladrillo no existe</h1>
          <p class="m-0 mt-3 text-white/60">Puede que el link esté mal escrito o que la pared no se haya podido leer.</p>
          <a href="/#mural-seccion" class="boton-ladrillo mt-6 inline-block px-6 py-3 text-sm uppercase tracking-wider no-underline">
            Volver al mural
          </a>
        </div>
      ) : (
        <div class="grid items-start gap-8 lg:grid-cols-[minmax(0,7fr)_minmax(0,5fr)]">
          <article class="cartel rounded-xl !px-6 !pb-8 !pt-10 md:!px-10" data-revelar>
            <p class="etiqueta m-0">
              Ladrillo #{id} · fila {fila + 1}, columna {columna + 1}
            </p>
            {ladrillo ? (
              <>
                <h1 class="m-0 mt-2">
                  El recuerdo de <span class="neon text-rosa">{recuerdo?.alias ?? 'un vecino'}</span>
                </h1>
                {recuerdo?.imagenCid && (
                  <img src={urlGateway(recuerdo.imagenCid)} alt={`Foto del recuerdo del ladrillo #${id}`} loading="lazy" decoding="async" width="800" height="600" class="mt-6 max-h-[420px] w-full border-2 border-junta object-cover" />
                )}
                {recuerdo ? (
                  <blockquote class="m-0 mt-6 border-l-4 border-ladrillo pl-5 text-2xl leading-snug md:text-3xl">“{recuerdo.texto}”</blockquote>
                ) : (
                  <p class="caja m-0 mt-6 p-4 text-white/70">
                    {falloRecuerdo ? 'No pudimos traer el recuerdo desde IPFS en este momento. El ladrillo sigue adoptado y su huella está guardada en la red.' : ''}
                  </p>
                )}
                <p class="m-0 mt-4 text-sm uppercase tracking-wider text-ambar">{fecha}</p>
              </>
            ) : (
              <>
                <h1 class="m-0 mt-2">
                  Este ladrillo <span class="neon text-ambar">está libre</span>
                </h1>
                <p class="m-0 mt-4 max-w-lg text-white/70">Todavía nadie lo adoptó. Podés ser la primera persona en dejarle un recuerdo.</p>
                <a href={`/?ladrillo=${id}#mural-seccion`} class="boton-ladrillo mt-6 inline-block px-6 py-3 text-sm uppercase tracking-wider no-underline">
                  Adoptá este ladrillo
                </a>
              </>
            )}
          </article>

          <aside class="flex flex-col gap-6" data-revelar style="transition-delay: 120ms">
            <div class="cartel !p-4 !pt-8">
              <p class="etiqueta m-0 mb-3">Su lugar en la pared</p>
              <div class="posicion relative w-full" style={`--x: ${columna}; --y: ${fila}; --columnas: ${columnas}; --filas: ${filas}`}>
                <img src="/mural.jpg" alt="Mural del barrio" width="1200" height="800" loading="lazy" decoding="async" class="block w-full opacity-40 grayscale" />
                <span class="marca absolute" />
              </div>
            </div>

            {ladrillo && (
              <dl class="cartel m-0 grid gap-4 text-sm">
                <div>
                  <dt class="etiqueta">Aporte</dt>
                  <dd class="m-0 font-display text-3xl text-ambar">{formatearUsdc(ladrillo.monto)}</dd>
                </div>
                <div>
                  <dt class="etiqueta">Adoptado por</dt>
                  <dd class="m-0">
                    <a href={`${RED.explorador}/account/${ladrillo.donante}`} target="_blank" rel="noopener" class="text-ambar"><code>{acortarDireccion(ladrillo.donante)}</code></a>
                    <button type="button" class="copiar-dato ml-2 cursor-pointer rounded-md border border-white/20 bg-transparent px-2 py-0.5 text-xs text-white/70 hover:border-ambar hover:text-ambar" data-copiar={ladrillo.donante} data-que="La dirección">Copiar</button>
                  </dd>
                </div>
                <details class="caja m-0 p-3 text-white/70">
                  <summary class="cursor-pointer font-bold text-white/80">Detalles técnicos</summary>
                  <p class="m-0 mt-2 text-sm">
                    El recuerdo está en IPFS (<a href={urlGateway(ladrillo.recuerdoCid)} target="_blank" rel="noopener" class="text-ambar"><code class="break-all">{ladrillo.recuerdoCid}</code></a>) y su huella quedó anclada en el contrato: si alguien cambiara el contenido, el hash dejaría de coincidir.{' '}
                    <a href={explorador} target="_blank" rel="noopener" class="text-ambar">Ver el contrato en el explorador</a>
                  </p>
                  <p class="m-0 mt-2 break-all text-sm text-white/50">Dirección completa: <code>{ladrillo.donante}</code></p>
                  <button type="button" class="copiar-dato mt-2 cursor-pointer rounded-md border border-white/20 bg-transparent px-2 py-1 text-xs text-white/70 hover:border-ambar hover:text-ambar" data-copiar={ladrillo.recuerdoCid} data-que="El CID del recuerdo">Copiar CID</button>
                </details>
              </dl>
            )}

            <div class="cartel flex items-center gap-4 !p-4 !pt-8">
              <div class="qr w-28 shrink-0 border-2 border-junta" set:html={qr} />
              <p class="m-0 text-sm text-white/70">Escaneá este código para abrir el ladrillo desde el celular o compartirlo.</p>
            </div>
          </aside>
        </div>
      )
    }
  </div>
</Base>

<script>
  document.querySelectorAll<HTMLButtonElement>('.copiar-dato').forEach((boton) => {
    boton.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(boton.dataset.copiar ?? '');
        window.dispatchEvent(new CustomEvent('pv:toast', { detail: { mensaje: `${boton.dataset.que} copiado al portapapeles`, tipo: 'exito' } }));
      } catch {
        window.dispatchEvent(new CustomEvent('pv:toast', { detail: { mensaje: 'No se pudo copiar', tipo: 'error' } }));
      }
    });
  });
</script>

<style>
  .posicion .marca {
    left: calc(var(--x) / var(--columnas) * 100%);
    top: calc(var(--y) / var(--filas) * 100%);
    width: calc(100% / var(--columnas));
    height: calc(100% / var(--filas));
    background-image: url('/mural.jpg');
    background-size: calc(var(--columnas) * 100%) calc(var(--filas) * 100%);
    background-position: calc(var(--x) / (var(--columnas) - 1) * 100%) calc(var(--y) / (var(--filas) - 1) * 100%);
    outline: 2px solid var(--color-primario);
    box-shadow: 0 0 16px 4px var(--color-primario);
    animation: latido 1.8s ease-in-out infinite;
  }
  .qr :global(svg) {
    display: block;
    width: 100%;
    height: auto;
  }
  @media (prefers-reduced-motion: reduce) {
    .posicion .marca {
      animation: none;
    }
  }
  @keyframes latido {
    50% {
      box-shadow: 0 0 4px 1px var(--color-primario);
    }
  }
</style>
