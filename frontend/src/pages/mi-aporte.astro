---
import Base from '../layouts/Base.astro';
import PanelPrueba from '../components/prueba/PanelPrueba.astro';
import Boton from '../components/ui/Boton.astro';
---

<Base titulo="Mi aporte">
  <div class="mx-auto max-w-4xl">
    <p class="etiqueta m-0">Tu lugar en la pared</p>
    <h1 class="m-0">Mi <span class="neon text-rosa">aporte</span></h1>
    <p class="m-0 mt-3 max-w-2xl text-white/70">
      Para ver y recuperar tus aportes conectá tu billetera (podés usar la de prueba: se crea en este navegador y usa dinero de mentira de la red de
      testeo).
    </p>
    <PanelPrueba />

    <section data-sin-wallet hidden>
      <div class="cartel mt-6 rounded-xl text-center" data-revelar>
        <p class="m-0 text-white/70">Todavía no conectaste tu billetera.</p>
        <Boton type="button" class="mt-4" data-conectar>Conectar mi billetera</Boton>
      </div>
    </section>

    <section data-contenido hidden>
      <div class="cifras mt-6 grid gap-4 sm:grid-cols-3" aria-busy="true">
        <div class="cartel rounded-xl !p-4" data-caja-total>
          <p class="etiqueta m-0">Total aportado</p>
          <p class="m-0 mt-1 font-display text-3xl text-ambar" data-total><span class="skeleton inline-block h-6 w-24 rounded-md"></span></p>
        </div>
        <div class="cartel rounded-xl !p-4">
          <p class="etiqueta m-0">Ladrillos adoptados</p>
          <p class="m-0 mt-1 font-display text-3xl text-ambar" data-cantidad><span class="skeleton inline-block h-6 w-12 rounded-md"></span></p>
        </div>
        <div class="cartel rounded-xl !p-4">
          <p class="etiqueta m-0">Guardián del mural</p>
          <p class="m-0 mt-1 font-display text-3xl text-ambar" data-guardian><span class="skeleton inline-block h-6 w-12 rounded-md"></span></p>
          <p class="m-0 mt-1 text-sm text-white/60" data-guardian-detalle hidden>
            Los guardianes cuidan la memoria del mural y ayudan a elegir la próxima pared. <a href="/guardianes" class="text-ambar">Conocé más</a>
          </p>
        </div>
      </div>

      <div class="cartel mt-6 rounded-xl border-l-4 !border-l-rosa" data-reembolso hidden>
        <p class="m-0 text-white/80">La campaña no alcanzó la meta antes de la fecha límite. Podés recuperar todo lo que aportaste.</p>
        <Boton type="button" class="mt-4" data-reembolsar>Recuperar mi aporte</Boton>
      </div>

      <p class="estado m-0 mt-4 text-violeta" data-estado role="status" hidden></p>
      <p class="exito m-0 mt-4 font-bold text-ambar" data-exito role="status" hidden></p>

      <h2 class="m-0 mt-8">Mis ladrillos</h2>
      <ul class="ladrillos mt-3 text-white/80" data-ladrillos>
        <li class="skeleton h-5 w-64 list-none rounded-md"></li>
      </ul>
    </section>

    <p class="error m-0 mt-4 text-rosa" data-error role="alert" hidden></p>
  </div>
</Base>

<script>
  import { datos } from '../lib/datos';
  import { formatearFecha } from '../lib/formato';
  import { traducirError } from '../lib/stellar/errores';
  import { alCambiarWallet, conectarYAvisar } from '../lib/stellar/sesion';
  import { esTxReal, reembolsar, urlTransaccion, type EtapaTx } from '../lib/stellar/transacciones';
  import { formatearUsdc } from '../lib/tipos';

  const $ = (sel: string) => document.querySelector(sel) as HTMLElement;
  const botonReembolsar = $('[data-reembolsar]') as HTMLButtonElement;

  const MENSAJES_ETAPA: Record<EtapaTx, string> = {
    firmando: 'Confirmá el reembolso en tu billetera…',
    enviando: 'Confirmando, unos segundos…',
  };

  let direccion: string | null = null;

  function mostrar(sel: string, contenido: string | null, html = false) {
    const el = $(sel);
    el.hidden = !contenido;
    if (html) el.innerHTML = contenido ?? '';
    else el.textContent = contenido ?? '';
  }

  async function render() {
    $('[data-sin-wallet]').hidden = !!direccion;
    $('[data-contenido]').hidden = !direccion;
    if (!direccion) return;
    try {
      const [c, aporte] = await Promise.all([datos.obtenerCampania(), datos.obtenerAporte(direccion)]);
      const reembolsado = aporte.total === 0n && aporte.ladrillos.length > 0;
      $('[data-total]').textContent = reembolsado ? 'Reembolsado' : formatearUsdc(aporte.total);
      $('[data-cantidad]').textContent = String(aporte.ladrillos.length);
      $('[data-guardian]').textContent = aporte.guardian ? 'Sí' : 'No';
      $('[data-guardian-detalle]').hidden = !aporte.guardian;
      $('[data-reembolso]').hidden = !(c.estado === 'Fallida' && aporte.total > 0n);
      botonReembolsar.textContent = `Recuperar ${formatearUsdc(aporte.total)}`;
      $('[data-ladrillos]').innerHTML = aporte.ladrillos.length
        ? aporte.ladrillos
            .map((l, i) => `<li data-revelar style="transition-delay: ${Math.min(i * 70, 560)}ms"><a href="/ladrillo/${l.id}" class="text-ambar">Ladrillo #${l.id}</a> · ${formatearUsdc(l.monto)} · ${formatearFecha(l.fecha)}</li>`)
            .join('')
        : '<li class="cartel list-none rounded-xl p-4 text-center text-white/70">Tu parte de la pared todavía está vacía.<br><a href="/#mural-seccion" class="boton-ladrillo mt-3 inline-block px-5 py-2 text-sm uppercase tracking-wider no-underline">Adoptá tu primer ladrillo</a></li>';
    } catch (e) {
      mostrar('[data-error]', traducirError(e));
    }
  }

  $('[data-conectar]').addEventListener('click', async () => {
    mostrar('[data-error]', null);
    try {
      await conectarYAvisar();
    } catch (e) {
      mostrar('[data-error]', traducirError(e));
    }
  });

  botonReembolsar.addEventListener('click', async () => {
    if (!direccion) return;
    botonReembolsar.disabled = true;
    mostrar('[data-error]', null);
    try {
      const { valor, txHash } = await reembolsar(direccion, (etapa) => mostrar('[data-estado]', MENSAJES_ETAPA[etapa]));
      const enlace = esTxReal(txHash) ? ` <a href="${urlTransaccion(txHash)}" target="_blank" rel="noopener" class="text-ambar">Ver el comprobante público</a>` : '';
      mostrar('[data-exito]', `Recuperaste ${formatearUsdc(valor)}. Ya están de vuelta en tu billetera.${enlace}`, true);
    } catch (e) {
      mostrar('[data-error]', traducirError(e));
    } finally {
      botonReembolsar.disabled = false;
      mostrar('[data-estado]', null);
      await render();
    }
  });

  alCambiarWallet((nueva) => {
    direccion = nueva;
    mostrar('[data-exito]', null);
    render();
  });
</script>

<style>
  .ladrillos li {
    margin-bottom: 0.5rem;
  }
  .ladrillos :global(a) {
    text-underline-offset: 3px;
  }
  .error {
    font-weight: 600;
  }
</style>
