---
import Base from '../layouts/Base.astro';
import PanelPrueba from '../components/prueba/PanelPrueba.astro';
---

<Base titulo="Mi aporte">
  <h1>Mi aporte</h1>
  <PanelPrueba />

  <section data-sin-wallet hidden>
    <p>Conectá tu wallet para ver tus aportes y tus ladrillos.</p>
    <button type="button" class="accion" data-conectar>Conectar wallet</button>
  </section>

  <section data-contenido hidden>
    <div class="cifras">
      <div class="cifra"><span>Total aportado</span><strong data-total>—</strong></div>
      <div class="cifra"><span>Ladrillos adoptados</span><strong data-cantidad>—</strong></div>
      <div class="cifra"><span>Guardián</span><strong data-guardian>—</strong></div>
    </div>

    <div class="reembolso" data-reembolso hidden>
      <p>La campaña no alcanzó la meta antes de la fecha límite. Podés recuperar todo lo que aportaste.</p>
      <button type="button" class="accion" data-reembolsar>Recuperar mi aporte</button>
    </div>

    <p class="estado" data-estado role="status" hidden></p>
    <p class="exito" data-exito role="status" hidden></p>

    <h2>Mis ladrillos</h2>
    <ul class="ladrillos" data-ladrillos></ul>
  </section>

  <p class="error" data-error role="alert" hidden></p>
</Base>

<script>
  import { datos } from '../lib/datos';
  import { traducirError } from '../lib/stellar/errores';
  import { alCambiarWallet, conectarYAvisar } from '../lib/stellar/sesion';
  import { esTxReal, reembolsar, urlTransaccion, type EtapaTx } from '../lib/stellar/transacciones';
  import { formatearUsdc } from '../lib/tipos';

  const $ = (sel: string) => document.querySelector(sel) as HTMLElement;
  const botonReembolsar = $('[data-reembolsar]') as HTMLButtonElement;

  const MENSAJES_ETAPA: Record<EtapaTx, string> = {
    firmando: 'Confirmá el reembolso en Freighter…',
    enviando: 'Enviando a la red Stellar…',
  };

  let direccion: string | null = null;

  function mostrar(sel: string, contenido: string | null, html = false) {
    const el = $(sel);
    el.hidden = !contenido;
    if (html) el.innerHTML = contenido ?? '';
    else el.textContent = contenido ?? '';
  }

  async function render() {
    $('[data-sin-wallet]').hidden = !!direccion;
    $('[data-contenido]').hidden = !direccion;
    if (!direccion) return;
    try {
      const [c, aporte] = await Promise.all([datos.obtenerCampania(), datos.obtenerAporte(direccion)]);
      const reembolsado = aporte.total === 0n && aporte.ladrillos.length > 0;
      $('[data-total]').textContent = reembolsado ? 'Reembolsado' : formatearUsdc(aporte.total);
      $('[data-cantidad]').textContent = String(aporte.ladrillos.length);
      $('[data-guardian]').textContent = aporte.guardian ? 'Sí' : 'No';
      $('[data-reembolso]').hidden = !(c.estado === 'Fallida' && aporte.total > 0n);
      botonReembolsar.textContent = `Recuperar ${formatearUsdc(aporte.total)}`;
      $('[data-ladrillos]').innerHTML = aporte.ladrillos.length
        ? aporte.ladrillos
            .map(
              (l) =>
                `<li><a href="/ladrillo/${l.id}">Ladrillo #${l.id}</a> · ${formatearUsdc(l.monto)} · ${new Date(
                  l.fecha * 1000,
                ).toLocaleDateString('es-AR')}</li>`,
            )
            .join('')
        : '<li>Todavía no adoptaste ningún ladrillo. <a href="/">Adoptá uno en el mural</a>.</li>';
    } catch (e) {
      mostrar('[data-error]', traducirError(e));
    }
  }

  $('[data-conectar]').addEventListener('click', async () => {
    mostrar('[data-error]', null);
    try {
      await conectarYAvisar();
    } catch (e) {
      mostrar('[data-error]', traducirError(e));
    }
  });

  botonReembolsar.addEventListener('click', async () => {
    if (!direccion) return;
    botonReembolsar.disabled = true;
    mostrar('[data-error]', null);
    try {
      const { valor, txHash } = await reembolsar(direccion, (etapa) => mostrar('[data-estado]', MENSAJES_ETAPA[etapa]));
      const enlace = esTxReal(txHash) ? ` <a href="${urlTransaccion(txHash)}" target="_blank" rel="noopener">Ver transacción</a>` : '';
      mostrar('[data-exito]', `Recuperaste ${formatearUsdc(valor)}. Ya están de vuelta en tu wallet.${enlace}`, true);
    } catch (e) {
      mostrar('[data-error]', traducirError(e));
    } finally {
      botonReembolsar.disabled = false;
      mostrar('[data-estado]', null);
      await render();
    }
  });

  alCambiarWallet((nueva) => {
    direccion = nueva;
    mostrar('[data-exito]', null);
    render();
  });
</script>

<style>
  .cifras {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: var(--espacio);
    margin: var(--espacio) 0;
  }
  .cifra {
    background: white;
    border: 1px solid var(--color-borde);
    border-radius: var(--radio);
    padding: var(--espacio);
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .cifra span {
    font-size: 0.85rem;
    opacity: 0.75;
  }
  .cifra strong {
    font-size: 1.3rem;
  }
  .reembolso {
    border: 1px solid var(--color-primario);
    border-radius: var(--radio);
    padding: var(--espacio);
    margin-bottom: var(--espacio);
  }
  .reembolso p {
    margin-top: 0;
  }
  .accion {
    border: none;
    border-radius: var(--radio);
    padding: 0.6rem 1.2rem;
    font: inherit;
    font-weight: 600;
    background: var(--color-primario);
    color: white;
    cursor: pointer;
  }
  .accion:disabled {
    opacity: 0.6;
    cursor: wait;
  }
  .estado,
  .exito {
    color: var(--color-secundario);
  }
  .exito {
    font-weight: 600;
  }
  .error {
    color: var(--color-primario);
  }
  .ladrillos {
    padding-left: 1.2rem;
  }
</style>
